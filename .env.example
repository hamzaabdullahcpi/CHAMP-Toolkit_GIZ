# CHAMP Toolkit Environment Configuration

APP_URL="MY_APP_URL"

# Airtable Integration: set these in Vercel for Production and Preview.
# Published content refreshes automatically; tokens stay on the server.
AIRTABLE_BASE_ID="app..."
AIRTABLE_PAT="pat..."

# Server Port (Defaults to 3000 in dev and production PORT)
PORT=3000

# Google Analytics 4 Measurement ID override (e.g. "G-XXXXXXXXXX"). Leave blank to use the
# CHAMP property built into src/utils/googleAnalytics.ts.
# Analytics only loads after a visitor clicks Accept in the cookie banner. Vite reads this at
# build time, so redeploy after setting it in Vercel > Project Settings > Environment Variables.
VITE_GA_MEASUREMENT_ID=""
